<Window x:Class="Wpf_PueblosCLM.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="365">

    <Window.Resources>
        <DataTemplate x:Key="DataTemplateC">
            <Grid Width="160">
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Width="160"
                           Height="20" 
                           TextWrapping="Wrap" 
                           Text="{Binding pueblo}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Label Content="Pueblos de Castilla-La Mancha" 
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               FontSize="17"
               Margin="0,50,0,0"/>
        <ComboBox HorizontalAlignment="Left" 
                  Margin="117,108,0,0" 
                  VerticalAlignment="Top" 
                  Width="120" 
                  ItemsSource="{Binding listaPueblos}" 
                  ItemTemplate="{DynamicResource DataTemplateC}"/>
    </Grid>

</Window>
